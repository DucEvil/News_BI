# Điền khóa thật vào .env, không điền vào mã Python.
NEWSAPI_KEY=
NEWS_QUERY=Vietnam
# Để trống để tìm mọi ngôn ngữ; NewsAPI không hỗ trợ language=vi.
NEWS_LANGUAGE=
LOOKBACK_DAYS=7
NEWS_DELAY_HOURS=25
MAX_PAGES_PER_DAY=1
DAILY_REQUEST_BUDGET=80
COLLECT_INTERVAL_SECONDS=21600
POSTGRES_PASSWORD=
SUPERSET_SECRET_KEY=
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=
